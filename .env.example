# Mongo
MONGO_USERNAME=pusharoo
MONGO_PASSWORD=replace-with-a-long-random-url-safe-password
MONGO_DATABASE=Pusharoo
PUSHAROO_HTTP_PORT=8080
PUSHAROO_APP_ORIGIN=http://localhost:8080
PUSHAROO_WALLET_SIGNATURE_AUDIENCE=pusharoo-web
# Use an HTTPS app origin for public deployments. HTTP is permitted only for explicit localhost development.
# The origin must match the browser URL exactly (scheme, host, and port).
PUSHAROO_AUTH_ALLOW_HTTP_LOCALHOST=true
# Login challenges expire after this many minutes; sessions have an absolute lifetime and do not auto-renew.
PUSHAROO_AUTH_CHALLENGE_MINUTES=5
PUSHAROO_AUTH_SESSION_HOURS=8
# Trust only the IP of the proxy directly in front of the API. Compose persists API antiforgery/Data Protection keys in api-data-protection.
PUSHAROO_AUTH_TRUSTED_PROXY_IP=

# WalletConnect
PUSHAROO_WALLETCONNECT_PROJECT_ID=replace-with-your-walletconnect-project-id
PUSHAROO_DEFAULT_NETWORK=neo3:testnet
PUSHAROO_TESTNET_RPC_URL=https://testnet1.neo.coz.io:443
PUSHAROO_MAINNET_RPC_URL=https://mainnet1.neo.coz.io:443
# Configure independent fallback providers before production deployment.
PUSHAROO_TESTNET_FALLBACK_RPC_URL=
PUSHAROO_MAINNET_FALLBACK_RPC_URL=
PUSHAROO_TESTNET_CONTRACT_MANAGEMENT_HASH=0xfffdc93764dbaddd97c48f252a53ea4643faa3fd
PUSHAROO_MAINNET_CONTRACT_MANAGEMENT_HASH=0xfffdc93764dbaddd97c48f252a53ea4643faa3fd
PUSHAROO_TESTNET_FAUCET_CONTRACT_HASH=
PUSHAROO_FAUCET_TRUSTED_PROXY_IP=
PUSHAROO_FAUCET_TRUSTED_PROXY_NETWORK=172.16.0.0/12
PUSHAROO_FAUCET_RELAYER_WIF=
PUSHAROO_FAUCET_MAX_TRANSACTION_FEE_GAS=0.5
PUSHAROO_FAUCET_DAILY_FEE_BUDGET_GAS=5

# Relays (one isolated instance per Neo network)
PUSHAROO_RELAY_POLL_INTERVAL_SECONDS=15
PUSHAROO_RELAY_MAX_BLOCKS_PER_POLL=10
PUSHAROO_RELAY_START_AT_LATEST=true
# Set distinct random secrets of at least 32 characters before enabling Relay management.
PUSHAROO_RELAY_TESTNET_SERVICE_TOKEN=
PUSHAROO_RELAY_MAINNET_SERVICE_TOKEN=
PUSHAROO_RELAY_SCANNER_STALL_SECONDS=120
PUSHAROO_RELAY_WORKER_STALL_SECONDS=120
PUSHAROO_RELAY_MAX_SCANNER_LAG_BLOCKS=30
PUSHAROO_RELAY_MAX_QUEUE_DEPTH=1000

# Paid MainNet Relay (set both recipient values before enabling payments)
EVENT_RELAY_PAYMENT_RECIPIENT_ADDRESS=
EVENT_RELAY_PAID_PLAN_GAS_DATOSHIS=500000000
EVENT_RELAY_PAID_PLAN_DAYS=30
EVENT_RELAY_PAID_GRACE_DAYS=3
EVENT_RELAY_PAID_MAX_ACTIVE_SUBSCRIPTIONS=5
EVENT_RELAY_PAID_MAX_EVENTS=10000
EVENT_RELAY_PAYMENT_INTENT_MINUTES=15
EVENT_RELAY_PAYMENT_CONFIRMATION_BLOCKS=2
