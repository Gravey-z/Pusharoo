# Mongo
MONGO_USERNAME=pusharoo
MONGO_PASSWORD=replace-with-a-long-random-url-safe-password
MONGO_DATABASE=Pusharoo
PUSHAROO_HTTP_PORT=8080

# WalletConnect
PUSHAROO_WALLETCONNECT_PROJECT_ID=replace-with-your-walletconnect-project-id
PUSHAROO_DEFAULT_NETWORK=neo3:testnet
PUSHAROO_TESTNET_RPC_URL=https://testnet1.neo.coz.io:443
PUSHAROO_MAINNET_RPC_URL=https://mainnet1.neo.coz.io:443
# Configure independent fallback providers before production deployment.
PUSHAROO_TESTNET_FALLBACK_RPC_URL=
PUSHAROO_MAINNET_FALLBACK_RPC_URL=
PUSHAROO_TESTNET_CONTRACT_MANAGEMENT_HASH=0xfffdc93764dbaddd97c48f252a53ea4643faa3fd
PUSHAROO_MAINNET_CONTRACT_MANAGEMENT_HASH=0xfffdc93764dbaddd97c48f252a53ea4643faa3fd

# Relays (one isolated instance per Neo network)
PUSHAROO_RELAY_POLL_INTERVAL_SECONDS=15
PUSHAROO_RELAY_MAX_BLOCKS_PER_POLL=10
PUSHAROO_RELAY_SCANNER_STALL_SECONDS=120
PUSHAROO_RELAY_WORKER_STALL_SECONDS=120
PUSHAROO_RELAY_MAX_SCANNER_LAG_BLOCKS=30
PUSHAROO_RELAY_MAX_QUEUE_DEPTH=1000
