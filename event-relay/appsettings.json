{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "Pusharoo"
  },
  "NeoRpc": {
    "Endpoint": "https://mainnet1.neo.coz.io:443",
    "FallbackEndpoint": "",
    "Network": "neo3:mainnet",
    "PollIntervalSeconds": 15,
    "MaxBlocksPerPoll": 10,
    "ConfirmationBlocks": 1
  },
  "EventRelay": {
    "WebhookTimeoutSeconds": 15,
    "WebhookMaxAttempts": 4,
    "WebhookRetryBaseSeconds": 2,
    "DeliveryPayloadRetentionDays": 7,
    "DeliveryHistoryRetentionDays": 30,
    "RetentionSweepMinutes": 5,
    "TestnetSubscriptionRetentionDays": 7,
    "ScannerStallSeconds": 120,
    "DeliveryWorkerStallSeconds": 120,
    "MaxScannerLagBlocks": 30,
    "MaxQueueDepth": 1000,
    "FreeBetaPeriodDays": 7,
    "FreeTestnetMaxActiveSubscriptions": 5,
    "FreeTestnetMaxEvents": 1000,
    "PaymentRecipientAddress": "",
    "PaidPlanGasDatoshis": 500000000,
    "PaidPlanDays": 30,
    "PaidGraceDays": 3,
    "PaidMaxActiveSubscriptions": 5,
    "PaidMaxEvents": 10000,
    "PaymentIntentMinutes": 15,
    "PaymentConfirmationBlocks": 2
  },
  "PusharooApi": {
    "Endpoint": "http://localhost:5000"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
