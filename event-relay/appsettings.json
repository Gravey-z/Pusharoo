{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "Pusharoo"
  },
  "NeoRpc": {
    "Endpoint": "https://mainnet1.neo.coz.io:443",
    "Network": "neo3:mainnet",
    "PollIntervalSeconds": 15,
    "MaxBlocksPerPoll": 10,
    "ConfirmationBlocks": 1
  },
  "EventRelay": {
    "WebhookTimeoutSeconds": 15,
    "WebhookMaxAttempts": 4,
    "WebhookRetryBaseSeconds": 2,
    "DeliveryPayloadRetentionDays": 7,
    "DeliveryHistoryRetentionDays": 30,
    "RetentionSweepMinutes": 60
  },
  "PusharooApi": {
    "Endpoint": "http://localhost:5000"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
